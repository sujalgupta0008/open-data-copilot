DATABASE_URL=postgresql://postgres:postgres@localhost:5432/opendatacopilot
# For local dev without postgres, use sqlite:
# DATABASE_URL=sqlite:///./opendatacopilot.db
JWT_SECRET=change-this-to-a-strong-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# =============================================================
# AI Provider — Groq primary → Groq fallback → Deterministic
# PERFORMANCE: fast 8b-instant primary (sub-3s) → 8b-8192 fallback → deterministic
# NOTE: Groq removed llama-3.3-70b-versatile (404). For speed use llama-3.1-8b-instant or llama3-8b-8192.
# Valid fast models: llama-3.1-8b-instant, llama3-8b-8192, openai/gpt-oss-20b, qwen/qwen3.6-27b
# =============================================================
AI_PROVIDER=groq

# Groq primary — model 1 (set your API key below) — PERFORMANCE: llama-3.1-8b-instant (~0.8s) vs 70b (~6s)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1/chat/completions

# Groq fallback — model 2 (second API key; falls back to GROQ_API_KEY if empty) — also fast 8b
GROQ_FALLBACK_API_KEY=
GROQ_FALLBACK_MODEL=llama3-8b-8192
GROQ_FALLBACK_BASE_URL=https://api.groq.com/openai/v1/chat/completions

# Legacy Gemini vars kept for backwards compat but ignored when AI_PROVIDER=groq
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_BASE_URL=
# Generic fallback (unused when GROQ_* set)
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
STORAGE_PATH=./storage
PORT=8000
MAX_UPLOAD_SIZE_BYTES=5368709120
# 5GB BYOS — for large datasets via Google Drive streaming (was 50MB)

# =============================================================
# BYOS — Bring Your Own Storage via Google Drive (drive.file)
# =============================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
GOOGLE_DRIVE_FOLDER_NAME=Open_Data_Copilot_Workspace
GOOGLE_OAUTH_SCOPE=https://www.googleapis.com/auth/drive.file
DRIVE_MOCK_ENABLED=1
TMP_DIR=
# Real Drive requires: pip install google-api-python-client google-auth google-auth-oauthlib
# Mock mode (DRIVE_MOCK_ENABLED=1) uses local filesystem ./storage/drive/<user_id>/Open_Data_Copilot_Workspace

# =============================================================
# AI Provider Modes — How to test
# =============================================================
# For Groq primary active:
# GROQ_API_KEY=your_primary_groq_key
# GROQ_FALLBACK_API_KEY=your_fallback_groq_key (or leave empty to reuse primary key)
# AI_PROVIDER=groq
# # Backend logs: GROQ_REQUEST model=llama-3.1-8b-instant ... GROQ_SUCCESS (~0.8s)
# # On primary failure: GROQ_FAILURE → GROQ_REQUEST model=llama3-8b-8192 → GROQ_SUCCESS fallback
# # Frontend: Navbar green dot "Groq llama-3.1-8b-instant", Copilot badge "✓ Powered by Groq" (per-message badge = actual model)
# # If both fail: amber "⚡ Heuristic Mode — LLM unavailable" (deterministic fallback still runs SQL via DuckDB)
#
# For Heuristic Mode testing (intentionally blank):
# GROQ_API_KEY=
# GROQ_FALLBACK_API_KEY=
# AI_PROVIDER=mock
#
# Verification:
# curl -H "Authorization: Bearer <token>" http://localhost:8000/api/ai/status | jq
# # should show provider=groq, model=llama-3.1-8b-instant, groq_fallback_model=llama3-8b-8192
# # Test connectivity:
# curl -X POST -H "Authorization: Bearer <token>" http://localhost:8000/api/ai/test | jq
